# Plantilla de variables de entorno. Copiar a .env.local y completar.
# NO poner valores reales en este archivo: sí se commitea.

# Meta Conversions API — token de acceso del Pixel (Events Manager >
# Configuración > Conversions API > Generar token de acceso).
# El Pixel ID NO va acá: es público y vive en src/lib/meta/config.ts
META_CAPI_ACCESS_TOKEN=

# Opcional, solo para pruebas desde el Events Manager.
META_TEST_EVENT_CODE=
